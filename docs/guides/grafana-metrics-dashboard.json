  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "config-connector",
    "kcc",
    "kubernetes",
    "gcp"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "includeAll": false,
