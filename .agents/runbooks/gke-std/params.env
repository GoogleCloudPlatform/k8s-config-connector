# Execution parameters for the gke runbook.
# The first block is filled in by the plan for each run; the rest is built from it.

PROJECT=""          # the owner's brief, else GOOGLE_CLOUD_PROJECT
REGION=""           # the owner's brief, else CLOUDSDK_COMPUTE_REGION
ZONE=""             # a zone in REGION, e.g. ${REGION}-a
RESOURCE_PREFIX=""  # always this run's prefix (e.g. kcc-gke1), never hand-typed
IMAGE_TAG=""        # short SHA of the commit this run builds

CLUSTER_NAME="${RESOURCE_PREFIX}-cluster"
GSA_NAME="${RESOURCE_PREFIX}-sa"
GSA_EMAIL="${GSA_NAME}@${PROJECT}.iam.gserviceaccount.com"
ARTIFACT_REPO="${RESOURCE_PREFIX}-repo"
IMAGE_PREFIX="${REGION}-docker.pkg.dev/${PROJECT}/${ARTIFACT_REPO}/"

TEST_NAMESPACE="${RESOURCE_PREFIX}-test"
TEST_TOPIC_NAME="${RESOURCE_PREFIX}-test-topic"
