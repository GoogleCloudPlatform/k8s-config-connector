POST https://securitycenter.googleapis.com/v1/organizations/${organizationID}/securityHealthAnalyticsSettings/customModules?%24alt=json%3Benum-encoding%3Dint
Content-Type: application/json
User-Agent: kcc/${kccVersion} (+https://github.com/GoogleCloudPlatform/k8s-config-connector) kcc/controller-manager/${kccVersion} (mockgcp)
X-Goog-Request-Params: parent=organizations%2F${organizationID}%2FsecurityHealthAnalyticsSettings

{
  "customConfig": {
    "customOutput": {
      "properties": [
        {
          "name": "rotation_period",
          "valueExpression": {
            "description": "Resource rotation period value",
            "expression": "resource.rotationPeriod",
            "location": "customOutput.properties[0]",
            "title": "Rotation Period"
          }
        }
      ]
    },
    "description": "The rotation period is greater than 30 days.",
    "predicate": {
      "description": "Checks if key rotation period is too long",
      "expression": "resource.rotationPeriod \u003e duration('2592000s')",
      "location": "customConfig.predicate",
      "title": "Key Rotation Check"
    },
    "recommendation": "Set the rotation period to less than or equal to 30 days.",
    "resourceSelector": {
      "resourceTypes": [
        "cloudkms.googleapis.com/CryptoKey"
      ]
    },
    "severity": 2
  },
  "displayName": "custom_sha_max_${uniqueId}",
  "enablementState": 1
}

