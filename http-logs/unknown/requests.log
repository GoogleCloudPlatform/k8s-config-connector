eady')].reason"},{"name":"Status Age","type":"date","description":"The last transition time for the value in 'Status'","jsonPath":".status.conditions[?(@.type=='Ready')].lastTransitionTime"}]}],"conversion":{"strategy":"None"}},"status":{"conditions":null,"acceptedNames":{"plural":"","kind":""},"storedVersions":["v1beta1"]}}
