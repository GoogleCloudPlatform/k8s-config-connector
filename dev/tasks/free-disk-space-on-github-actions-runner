#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "${REPO_ROOT}"

# Free up disk space on GitHub Actions runners

if [[ -z "${GITHUB_ACTIONS:-}" ]]; then
  echo "Not running on GitHub Actions; skipping disk space cleanup (for safety)"
  exit 1
fi


echo "Before cleanup:"
df -h
df -i /


sudo rm -rf /opt/hostedtoolcache/*  # remove pre-installed tool versions
sudo rm -rf /usr/share/dotnet
sudo rm -rf /usr/local/lib/android # remove Android SDK
sudo rm -rf /usr/share/swift       # remove Swift
sudo rm -rf /usr/local/share/powershell /usr/local/share/chromium /opt/ghc || true
sudo rm -rf "${HOME}/.rustup" "${HOME}/.cargo" "${HOME}/.dotnet" "${HOME}/.npm" "${HOME}/.gradle" "${HOME}/.m2" || true
sudo docker system prune -af || true

echo "After cleanup:"
df -h
df -i /
