# Decides whether the full ci-presubmit suite needs to run.
#
# Writes run_ci=true|false to $GITHUB_OUTPUT (or stdout when unset).
# run_ci=false only when we can positively determine the changed files AND
# every changed file is under a path that the presubmit suite does not test
# (see SKIP_CI_PATH_REGEX). Any doubt (unknown event, missing SHAs, git
# errors, empty diff) results in run_ci=true.
#
# Inputs (environment):
#   EVENT_NAME    github.event_name
#   PR_BASE_SHA   github.event.pull_request.base.sha
#   PR_HEAD_SHA   github.event.pull_request.head.sha
#   MG_BASE_SHA   github.event.merge_group.base_sha
#   MG_HEAD_SHA   github.event.merge_group.head_sha

set -o errexit
set -o nounset
set -o pipefail

# Paths that the ci-presubmit suite does not exercise:
#   experiments/  - covered by the separate experiments-ci workflow
#   .gemini/      - agent skills, commands, hooks
#   .agents/      - agent graphs, workflows, runbooks
SKIP_CI_PATH_REGEX='^(experiments/|\.gemini/|\.agents/)'

emit() {
  local run_ci="$1" reason="$2"
  echo "run_ci=${run_ci} (${reason})"
  if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
    echo "run_ci=${run_ci}" >> "${GITHUB_OUTPUT}"
  fi
  exit 0
}

case "${EVENT_NAME:-}" in
  pull_request)
    base="${PR_BASE_SHA:-}"
    head="${PR_HEAD_SHA:-}"
    range_sep="..."
    ;;
  merge_group)
    base="${MG_BASE_SHA:-}"
    head="${MG_HEAD_SHA:-}"
    range_sep=".."
    ;;
  *)
    emit true "event '${EVENT_NAME:-}' always runs the full suite"
    ;;
esac

if [[ -z "${base}" || -z "${head}" ]]; then
  emit true "missing base/head SHA"
fi

if ! changed=$(git diff --name-only --no-renames "${base}${range_sep}${head}"); then
  emit true "git diff failed"
fi

if [[ -z "${changed}" ]]; then
  emit true "no changed files detected"
fi

echo "Changed files:"
echo "${changed}" | sed 's/^/  /'

if code_changes=$(echo "${changed}" | grep -Ev "${SKIP_CI_PATH_REGEX}"); then
  echo "Files requiring the full suite:"
  echo "${code_changes}" | sed 's/^/  /'
  emit true "changes outside skip-ci paths"
fi

emit false "all changes are under skip-ci paths"
