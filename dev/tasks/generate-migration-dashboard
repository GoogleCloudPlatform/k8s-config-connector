def get_repo_root():
    return subprocess.check_output(['git', 'rev-parse', '--show-toplevel']).strip().decode('utf-8')


def parse_static_config(repo_root, include_greenfield=False):
    file_path = os.path.join(repo_root, "pkg", "controller", "resourceconfig", "static_config.go")
    pattern = re.compile(
        r'\{\s*Group:\s*"([^"]+)",\s*Kind:\s*"([^"]+)"\s*\}:\s*\{\s*DefaultController:\s*k8s\.(\w+),\s*SupportedControllers:\s*\[\]k8s\.ReconcilerType\{([^}]+)\}\s*\}'
    )
    resources = []
    with open(file_path, "r", encoding="utf-8") as f:
        for line in f:
            m = pattern.search(line)
            if not m:
                continue
            group, kind, default_ctrl, supported_raw = m.groups()
            supported = [c.strip().replace("k8s.", "").replace("ReconcilerType", "").lower() for c in supported_raw.split(",")]
            def_ctrl = default_ctrl.replace("ReconcilerType", "").lower()
            service = group.split(".")[0]

            is_migration_resource = any(c in ("terraform", "dcl", "iampartialpolicy") for c in supported)

            # Strip greenfield direct controllers and dedicated IAM controllers unless explicitly requested
            if not include_greenfield and not is_migration_resource:
                continue

            # Categorize migration status
            if "direct" in supported:
                if len(supported) == 1:
                    status = "Direct Complete"
                    action = "Legacy Retired (Direct Only)"
                    category = "direct_only"
                elif def_ctrl == "direct":
                    status = "Direct Default (Dual)"
                    action = "Deprecate Legacy Fallback"
                    category = "direct_default_dual"
                else:
                    status = "Dual (Ready for Flip)"
                    action = f"Qualify & Flip Default (currently {def_ctrl.upper()})"
                    category = "dual_pending_flip"
            elif def_ctrl == "terraform" or "terraform" in supported:
                status = "Legacy TF Only"
                action = "Implement Direct Controller"
                category = "tf_only"
            elif def_ctrl == "dcl" or "dcl" in supported:
                status = "Legacy DCL Only"
                action = "Implement Direct Controller"
                category = "dcl_only"
            else:
                status = "Special IAM"
                action = "IAM Custom Controller"
                category = "special_iam"

            resources.append({
                "group": group,
                "kind": kind,
                "service": service,
                "default_controller": def_ctrl,
                "supported_controllers": supported,
                "status": status,
                "action": action,
                "category": category,
            })
    return resources


def load_or_update_history(repo_root, current_direct_ready, current_direct_default):
    if not repo_root:
        return []
    history_file = os.path.join(repo_root, "dev", "migration-tracker", "migration_history.json")
    today_str = datetime.date.today().strftime("%Y-%m-%d")
    today_label = datetime.date.today().strftime("%b %d, '%y")

    history = []
    if os.path.exists(history_file):
        try:
            with open(history_file, "r", encoding="utf-8") as f:
                history = json.load(f)
        except Exception:
            history = []

    found = False
    for item in history:
        if item.get("date") == today_str:
            item["implemented"] = current_direct_ready
            item["flipped"] = current_direct_default
            item["label"] = today_label
            found = True
            break
    if not found:
        history.append({
            "date": today_str,
            "label": today_label,
            "implemented": current_direct_ready,
            "flipped": current_direct_default,
        })

    history.sort(key=lambda x: x.get("date", ""))

    try:
        os.makedirs(os.path.dirname(history_file), exist_ok=True)
        with open(history_file, "w", encoding="utf-8") as f:
            json.dump(history, f, indent=2)
    except Exception:
        pass

    return history


def calculate_metrics(resources, start_date, target_date, repo_root=None):
    total = len(resources)
    tf_only = sum(1 for r in resources if r["category"] == "tf_only")
    dcl_only = sum(1 for r in resources if r["category"] == "dcl_only")
    dual_pending = sum(1 for r in resources if r["category"] == "dual_pending_flip")
    direct_default_dual = sum(1 for r in resources if r["category"] == "direct_default_dual")
    direct_only = sum(1 for r in resources if r["category"] == "direct_only")
    special_iam = sum(1 for r in resources if r["category"] == "special_iam")

    legacy_remaining = tf_only + dcl_only
    direct_ready = direct_only + direct_default_dual + dual_pending
    direct_default_count = direct_default_dual + direct_only
    flips_needed = total - direct_default_count  # 301 total scope - 2 already flipped = 299 flips needed!
    total_actions_needed = legacy_remaining + flips_needed  # 221 implementations + 299 flips = 520 actions

    days_remaining = max(1, (target_date - start_date).days)
    weeks_remaining = max(1.0, days_remaining / 7.0)

    # Required velocities
    direct_impl_velocity = legacy_remaining / weeks_remaining
    flip_velocity = flips_needed / weeks_remaining
    total_actions_velocity = total_actions_needed / weeks_remaining

    # Group by service
    services = {}
    for r in resources:
        s = r["service"]
        if s not in services:
            services[s] = {
                "name": s,
                "total": 0,
                "direct_ready": 0,
                "dual_pending": 0,
                "legacy_tf": 0,
                "legacy_dcl": 0,
            }
        services[s]["total"] += 1
        cat = r["category"]
        if "direct" in r["supported_controllers"]:
            services[s]["direct_ready"] += 1
            if cat == "dual_pending_flip":
                services[s]["dual_pending"] += 1
        elif cat == "tf_only":
            services[s]["legacy_tf"] += 1
        elif cat == "dcl_only":
            services[s]["legacy_dcl"] += 1

    for s in services.values():
        s["remaining_action"] = s["legacy_tf"] + s["legacy_dcl"] + s["dual_pending"]
        s["pct_direct"] = round((s["direct_ready"]) / max(1, s["total"]) * 100, 1)

    top_services = sorted(services.values(), key=lambda x: x["remaining_action"], reverse=True)

    # Historical tracking
    history = load_or_update_history(repo_root, direct_ready, direct_default_count)
    if not history:
        history = [{
            "date": start_date.strftime("%Y-%m-%d"),
            "label": start_date.strftime("%b %d, '%y"),
            "implemented": direct_ready,
            "flipped": direct_default_count,
        }]

    real_impl_series = [h["implemented"] for h in history]
    real_flip_series = [h["flipped"] for h in history]

    # Timeline Trajectory (Start date -> Q1 2027)
    num_weeks = int(math.ceil(weeks_remaining))
    timeline_labels = []
    projected_impl_series = []
    projected_flip_series = []
    direct_ready_series = []
    legacy_remaining_series = []
    dual_pending_series = []
    completion_pct_series = []
    cumulative_actions_series = []
    weekly_velocity_series = []

    curr = start_date
    for i in range(num_weeks + 1):
        timeline_labels.append(curr.strftime("%b %d, '%y"))
        progress_ratio = min(1.0, i / float(num_weeks))
        rem_ratio = max(0.0, 1.0 - progress_ratio)

        # 1. Projected progress to implement direct controller (linear from 80 to 301)
        cur_proj_impl = round(80.0 + (301.0 - 80.0) * progress_ratio, 1)
        projected_impl_series.append(cur_proj_impl)

        # 2. Projected flipping to direct default effort (exponential from 2 to 301)
        cur_proj_flip = round(2.0 * math.pow(301.0 / 2.0, progress_ratio), 1)
        projected_flip_series.append(cur_proj_flip)

        # Direct count climbing from current direct_ready (80) to total (301)
        cur_direct = round(direct_ready + (legacy_remaining * progress_ratio))
        direct_ready_series.append(cur_direct)

        # Legacy count burning down from 221 to 0
        cur_legacy = round(legacy_remaining * rem_ratio)
        legacy_remaining_series.append(cur_legacy)

        # Dual pending flip burning down from 78 to 0
        cur_dual = round(dual_pending * rem_ratio)
        dual_pending_series.append(cur_dual)

        # Overall completion % climbing from (80/301 = 26.6%) to 100%
        cur_pct = round((cur_direct / float(total)) * 100.0, 1)
        completion_pct_series.append(cur_pct)

        # Cumulative flips completed (0 -> 299)
        cur_actions = round(flips_needed * progress_ratio)
        cumulative_actions_series.append(cur_actions)

        # Weekly target flip pace (~11.8 / wk)
        weekly_velocity_series.append(round(flip_velocity, 1))

        curr += datetime.timedelta(days=7)

    # Advisory calculation based on latest recorded actual
    latest_idx = len(history) - 1
    latest_real_impl = history[latest_idx]["implemented"]
    latest_real_flip = history[latest_idx]["flipped"]
    latest_proj_impl = projected_impl_series[latest_idx]
    latest_proj_flip = projected_flip_series[latest_idx]

    impl_diff = round(latest_real_impl - latest_proj_impl, 1)
    if impl_diff > 0.5:
        impl_status = "ahead"
        impl_status_text = "Ahead of Schedule (Faster)"
        impl_class = "advisory-ahead"
        impl_icon = "&#128640;"
        impl_msg = f"+{impl_diff} controllers ahead of plan"
    elif impl_diff < -0.5:
        impl_status = "behind"
        impl_status_text = "Behind Schedule"
        impl_class = "advisory-behind"
        impl_icon = "&#9888;&#65039;"
        impl_msg = f"{abs(impl_diff)} controllers behind plan"
    else:
        impl_status = "ontime"
        impl_status_text = "On Track / On Time"
        impl_class = "advisory-ontime"
        impl_icon = "&#9989;"
        impl_msg = "Matching target pace"

    flip_diff = round(latest_real_flip - latest_proj_flip, 1)
    if flip_diff > 0.5:
        flip_status = "ahead"
        flip_status_text = "Ahead of Schedule (Faster)"
        flip_class = "advisory-ahead"
        flip_icon = "&#128640;"
        flip_msg = f"+{flip_diff} flips ahead of plan"
    elif flip_diff < -0.5:
        flip_status = "behind"
        flip_status_text = "Behind Schedule"
        flip_class = "advisory-behind"
        flip_icon = "&#9888;&#65039;"
        flip_msg = f"{abs(flip_diff)} flips behind plan"
    else:
        flip_status = "ontime"
        flip_status_text = "On Track / On Time"
        flip_class = "advisory-ontime"
        flip_icon = "&#9989;"
        flip_msg = "Matching target pace"

    advisory = {
        "as_of_label": history[latest_idx].get("label", "Current Week"),
        "impl": {
            "status": impl_status,
            "status_text": impl_status_text,
            "class": impl_class,
            "icon": impl_icon,
            "real": latest_real_impl,
            "projected": latest_proj_impl,
            "diff": impl_diff,
            "msg": impl_msg,
        },
        "flip": {
            "status": flip_status,
            "status_text": flip_status_text,
            "class": flip_class,
            "icon": flip_icon,
            "real": latest_real_flip,
            "projected": latest_proj_flip,
            "diff": flip_diff,
            "msg": flip_msg,
        },
    }

    return {
        "total": total,
        "advisory": advisory,
        "tf_only": tf_only,
        "dcl_only": dcl_only,
        "dual_pending": dual_pending,
        "direct_default_dual": direct_default_dual,
        "direct_only": direct_only,
        "special_iam": special_iam,
        "legacy_remaining": legacy_remaining,
        "direct_ready": direct_ready,
        "flips_needed": flips_needed,
        "total_actions_needed": total_actions_needed,
        "days_remaining": days_remaining,
        "weeks_remaining": round(weeks_remaining, 1),
        "direct_impl_velocity": round(direct_impl_velocity, 1),
        "flip_velocity": round(flip_velocity, 1),
        "total_actions_velocity": round(total_actions_velocity, 1),
        "services": top_services,
        "timeline": {
            "labels": timeline_labels,
            "projected_impl": projected_impl_series,
            "projected_flip": projected_flip_series,
            "real_impl": real_impl_series,
            "real_flip": real_flip_series,
            "direct_ready": direct_ready_series,
            "legacy_remaining": legacy_remaining_series,
            "dual_pending": dual_pending_series,
            "completion_pct": completion_pct_series,
            "cumulative_actions": cumulative_actions_series,
            "weekly_velocity": weekly_velocity_series,
        },
    }


def render_svg_chart1(timeline, total_count=301):
    labels = timeline["labels"]
    proj_impl = timeline["projected_impl"]
    proj_flip = timeline["projected_flip"]
    real_impl = timeline.get("real_impl", [80])
    real_flip = timeline.get("real_flip", [2])
    n = max(1, len(labels) - 1)

    px, py, pw, ph = 40, 30, 890, 245
    max_count = 301.0

    def pt(i, val):
        x = px + (i / float(n)) * pw
        y = py + (1.0 - (val / max_count)) * ph
        return x, y

    proj_impl_coords = [pt(i, proj_impl[i]) for i in range(len(proj_impl))]
    proj_flip_coords = [pt(i, proj_flip[i]) for i in range(len(proj_flip))]
    real_impl_coords = [pt(i, real_impl[i]) for i in range(len(real_impl))]
    real_flip_coords = [pt(i, real_flip[i]) for i in range(len(real_flip))]

    proj_impl_path = "M " + " L ".join(f"{x:.1f},{y:.1f}" for x, y in proj_impl_coords)
    proj_flip_path = "M " + " L ".join(f"{x:.1f},{y:.1f}" for x, y in proj_flip_coords)

    # Gridlines and RIGHT axis ticks only (0 to 301)
    grid_lines = []
    tick_values = [0, 50, 100, 150, 200, 250, 301]
    for val in tick_values:
        y = py + (1.0 - (val / max_count)) * ph
        grid_lines.append(f'<line x1="{px}" y1="{y:.1f}" x2="{px+pw}" y2="{y:.1f}" stroke="rgba(51, 65, 85, 0.5)" stroke-width="1" />')
        grid_lines.append(f'<text x="{px+pw+10}" y="{y+4:.1f}" fill="#94a3b8" font-size="10" text-anchor="start">{val}</text>')

    # X-axis date labels (spaced out across full width)
    x_labels = []
    step_idx = max(1, n // 8)
    for i in range(0, n + 1, step_idx):
        x = px + (i / float(n)) * pw
        lbl = labels[i]
        x_labels.append(f'<text x="{x:.1f}" y="{py+ph+22}" fill="#64748b" font-size="10" text-anchor="middle">{lbl}</text>')

    # Solid Real lines & markers
    real_impl_svg = []
    if len(real_impl_coords) > 1:
        path_str = "M " + " L ".join(f"{x:.1f},{y:.1f}" for x, y in real_impl_coords)
        real_impl_svg.append(f'<path d="{path_str}" fill="none" stroke="#10b981" stroke-width="3.5" />')
    elif len(real_impl_coords) == 1:
        x, y = real_impl_coords[0]
        real_impl_svg.append(f'<line x1="{x-6:.1f}" y1="{y:.1f}" x2="{x+6:.1f}" y2="{y:.1f}" stroke="#10b981" stroke-width="3.5" stroke-linecap="round" />')

    for x, y in real_impl_coords:
        real_impl_svg.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="6" fill="#10b981" stroke="#0f172a" stroke-width="2" />')

    real_flip_svg = []
    if len(real_flip_coords) > 1:
        path_str = "M " + " L ".join(f"{x:.1f},{y:.1f}" for x, y in real_flip_coords)
        real_flip_svg.append(f'<path d="{path_str}" fill="none" stroke="#06b6d4" stroke-width="3.5" />')
    elif len(real_flip_coords) == 1:
        x, y = real_flip_coords[0]
        real_flip_svg.append(f'<line x1="{x-6:.1f}" y1="{y:.1f}" x2="{x+6:.1f}" y2="{y:.1f}" stroke="#06b6d4" stroke-width="3.5" stroke-linecap="round" />')

    for x, y in real_flip_coords:
        real_flip_svg.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="6" fill="#06b6d4" stroke="#0f172a" stroke-width="2" />')

    svg = f"""
    <svg id="svgChart1" viewBox="0 0 1000 320" width="100%" height="100%" style="overflow: visible; font-family: sans-serif;">
      <!-- Grid -->
      {"".join(grid_lines)}
      {"".join(x_labels)}

      <!-- Right Axis Header Only -->
      <text x="{px+pw}" y="18" fill="#f8fafc" font-size="11" font-weight="600" text-anchor="end">Controllers (0 &ndash; 301)</text>

      <!-- Dotted Projected Lines -->
      <path d="{proj_impl_path}" fill="none" stroke="#34d399" stroke-width="2.5" stroke-dasharray="5,5" />
      <path d="{proj_flip_path}" fill="none" stroke="#22d3ee" stroke-width="2.5" stroke-dasharray="5,5" />

      <!-- Solid Real Progress Lines & Markers -->
      {"".join(real_impl_svg)}
      {"".join(real_flip_svg)}

      <!-- Interactive Crosshair -->
      <line id="crosshair1" x1="0" y1="{py}" x2="0" y2="{py+ph}" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3,3" style="display: none;" />

      <!-- Transparent interaction overlay -->
      <rect x="{px}" y="{py}" width="{pw}" height="{ph}" fill="transparent" style="cursor: crosshair;" onmousemove="handleChart1Hover(event)" onmouseleave="hideChart1Hover()" />
    </svg>
    """
    return svg


