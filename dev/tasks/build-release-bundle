sed -i -E "s/\"?0.0.0-dev\"?/\"${VERSION}\"/g" ${GCP_IDENTITY_BUNDLE_DIR}/*
# Create the autopilot variant of the secret volume install bundle
AUTOPILOT_GCP_IDENTITY_BUNDLE_DIR=${BUNDLE_DIR}/install-bundle-autopilot-gcp-identity
