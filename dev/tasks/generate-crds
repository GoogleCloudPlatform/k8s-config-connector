set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd ${REPO_ROOT}

if [[ -n ${SKIP_GENERATE_CRDS:-} ]]; then
  echo "SKIP_GENERATE_CRDS is set; skipping generation of CRDs"
  exit 0
fi

mkdir -p ${REPO_ROOT}/bin

CONTROLLER_GEN="${REPO_ROOT}/bin/controller-gen"
if [[ ! -x "${CONTROLLER_GEN}" ]]; then
  echo "Prebuilding controller-gen..."
  GOBIN="${REPO_ROOT}/bin" go install sigs.k8s.io/controller-tools/cmd/controller-gen@v0.16.5
fi

ADD_VALIDATION="${REPO_ROOT}/bin/add-validation-to-crds"
if [[ ! -x "${ADD_VALIDATION}" ]]; then
  echo "Prebuilding add-validation-to-crds..."
  (cd ${REPO_ROOT} && go build -o "${ADD_VALIDATION}" ./scripts/add-validation-to-crds)
fi

CRD_TOOLS="${REPO_ROOT}/bin/crd-tools"
if [[ ! -x "${CRD_TOOLS}" ]]; then
  echo "Prebuilding crd-tools..."
  (cd ${REPO_ROOT} && go build -o "${CRD_TOOLS}" ./scripts/crd-tools)
fi

GENERATE_GVKS="${REPO_ROOT}/bin/generate-gvks"
if [[ ! -x "${GENERATE_GVKS}" ]]; then
  echo "Prebuilding generate-gvks..."
  (cd ${REPO_ROOT} && go build -o "${GENERATE_GVKS}" ./scripts/generate-gvks/main.go)
fi

GENERATE_ROLES="${REPO_ROOT}/bin/generate-cnrm-cluster-roles"
if [[ ! -x "${GENERATE_ROLES}" ]]; then
  echo "Prebuilding generate-cnrm-cluster-roles..."
  (cd ${REPO_ROOT} && go build -o "${GENERATE_ROLES}" ./scripts/generate-cnrm-cluster-roles/main.go)
fi

# Run controller-gen to generate CRDs (including deepcopy)
cd ${REPO_ROOT}/apis
"${CONTROLLER_GEN}" \
  object:headerFile=${REPO_ROOT}/hack/boilerplate.go.txt \
  crd:crdVersions=v1,allowDangerousTypes=true,ignoreUnexportedFields=true \
  output:crd:artifacts:config=config/crd/ \
  paths="./..."

# Add OpenAPI validation to refs
cd ${REPO_ROOT}
"${ADD_VALIDATION}" --dir apis/config/crd/

# Apply a few small tweaks to the CRDs
cd ${REPO_ROOT}
"${CRD_TOOLS}" set-field spec.preserveUnknownFields=false --dir apis/config/crd/
"${CRD_TOOLS}" delete-field status --dir apis/config/crd/
"${CRD_TOOLS}" set-annotation cnrm.cloud.google.com/version=0.0.0-dev --dir apis/config/crd/
"${CRD_TOOLS}" delete-annotation controller-gen.kubebuilder.io/version --dir apis/config/crd/
"${CRD_TOOLS}" reflow-descriptions --dir apis/config/crd/
"${CRD_TOOLS}" backport-alpha --dir apis/config/crd/

# Copy generated CRDs to apis/config/crd/
# The crds directory is generated only as part of the release (currently)

# excluded_resources are resources that are under development for a direct conversion
# we don't modify the CRD just yet for those but will in the future
#excluded_resources=("securesourcemanagerinstance")
excluded_resources=()

cd ${REPO_ROOT}
cd apis/config/crd/
for file in *.yaml; do
    excluded=false

    for substring in "${excluded_resources[@]}"; do
        if [[ "$file" == *"$substring"* ]]; then
            excluded=true
            break
        fi
    done
    if [ "$excluded" = true ]; then
        echo "Skipping $file as its CRD conversion is excluded for now"
        continue
    fi

    base_name=$(echo "$file" | sed 's/.yaml$//g')
    domain=$(echo "$base_name" | cut -d'_' -f1)
    resource=$(echo "$base_name" | cut -d'_' -f2)
    new_name="apiextensions.k8s.io_v1_customresourcedefinition_${resource}.${domain}.yaml";
    echo "# Generated by dev/tasks/generate-crds.  DO NOT EDIT." > "${REPO_ROOT}/config/crds/resources/$new_name"
    echo "" >> "${REPO_ROOT}/config/crds/resources/$new_name"
    cat "$file" >> "${REPO_ROOT}/config/crds/resources/$new_name"
    #echo "Renamed $file to $new_name"
done

# clean up apis/config/crd for now
cd ${REPO_ROOT}
rm -rf apis/config/crd

# Generated the supported GVKs file
"${GENERATE_GVKS}" -output-dir=pkg/gvks/supportedgvks

# Generate the cnrm_admin.yaml and cnrm_viewer.yaml RBAC files
"${GENERATE_ROLES}"

# controller-gen sometimes leaves empty imports in the api files.
source "${REPO_ROOT}/dev/tools/goimports.sh"
go run -mod=readonly golang.org/x/tools/cmd/goimports@${GOLANG_X_TOOLS_VERSION} -w apis
