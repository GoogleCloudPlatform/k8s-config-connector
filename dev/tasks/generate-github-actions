    runs-on: ubuntu-latest
    needs: plan-tests
    if: \${{ github.event.action != 'destroyed' && $(job_condition "${name}") }}
EOF

    if [[ "${name}" == "golangci-lint" ]]; then
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - name: Free up disk space
        run: dev/tasks/free-disk-space-on-github-actions-runner
      - uses: actions/setup-go@f111f3307d8850f501ac008e886eec1fd1932a34 # v5.3.0
        with:
          go-version-file: 'go.work'
          cache: false
      - name: Pre-warm Go build cache in batches to bound /tmp usage
        run: |
          go mod download
          rm -rf "\$(go env GOMODCACHE)/cache/download"
          go list -e -compiled=true -test=true -export=true -deps=true ./apis/... ./pkg/k8s/... ./pkg/clients/... ./pkg/gcpclients/... >/dev/null
          go list -e -compiled=true -test=true -export=true -deps=true ./pkg/controller/direct/... >/dev/null
          go list -e -compiled=true -test=true -export=true -deps=true ./pkg/... >/dev/null
          go list -e -compiled=true -test=true -export=true -deps=true ./mockgcp/... ./dev/... ./experiments/... >/dev/null
      - name: golangci-lint
        uses: golangci/golangci-lint-action@a4f60bb28d35aeee14e6880718e0c85ff1882e64 # v6.0.1
        with:
          version: v2.9.0
          args: --timeout=20m
          skip-cache: true
EOF
    continue
    fi

    if [[ "${name}" == "license-lint" ]]; then
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0
# zizmor: ignore[unpinned-uses]
      - uses: ./dev/actions/cache-go
      - name: "Run ${f}"
        run: |
          ./${f}
        env:
          ARTIFACTS: /tmp/artifacts
      - name: "Upload artifacts"
        uses: actions/upload-artifact@4cec3d8aa04e39d1a68397de0c4cd6fb9dce8ec1 # v4.6.1
        if: \${{ !cancelled() }}
        with:
          name: artifacts-${name}
          path: /tmp/artifacts/

EOF
    continue
    fi


    if [[ "${name}" == "validate-untested-fields" ]]; then
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0
EOF
    else
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
EOF
    fi

    if [[ "${name}" == "smoketest-with-kind" ]]; then
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@c47758b77c9736f4b2ef4073d4d51994fabfe349 # v3.7.1
EOF
    fi

    if [[ "${name}" == "validate-fmt" || "${name}" == "validate-github-actions" || "${name}" == "validate-resource-docs" || "${name}" == "validate-untested-fields" || "${name}" == "smoketest-with-kind" ]]; then
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
      - uses: actions/setup-go@f111f3307d8850f501ac008e886eec1fd1932a34 # v5.3.0
        with:
          go-version-file: 'go.mod'
          cache: false
EOF
    else
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
# zizmor: ignore[unpinned-uses]
      - uses: ./dev/actions/cache-go
EOF
    fi

    if [[ "${name}" == "validate-untested-fields" ]]; then
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
      - name: "Run ${f}"
        run: |
          ./${f}
        env:
          COMMIT_HEAD: \${{ github.event.pull_request.head.sha }}
          BASE_COMMIT: \${{ github.event.pull_request.base.sha }}
          ARTIFACTS: /tmp/artifacts
EOF
    else
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
      - name: "Run ${f}"
        run: |
          ./${f}
        env:
          ARTIFACTS: /tmp/artifacts
EOF
        extra_env="$(job_env "${name}")"
        if [[ -n "${extra_env}" ]]; then
            echo "${extra_env}" >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml
        fi
    fi

cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
      - name: "Upload artifacts"
        uses: actions/upload-artifact@4cec3d8aa04e39d1a68397de0c4cd6fb9dce8ec1 # v4.6.1
        if: \${{ !cancelled() }}
        with:
          name: artifacts-${name}
          path: /tmp/artifacts/

EOF

done

cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF

  presubmit-gatekeeper:
    name: presubmit-gatekeeper
    needs:
      - plan-tests
      - prepare-test-matrix
EOF

for job in "${jobs_array[@]}"; do
cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
      - ${job}
EOF
done

cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<EOF
    runs-on: ubuntu-latest
    if: \${{ !cancelled() && github.event.action != 'destroyed' }} # Ensure this runs even if some dependencies fail, but not if the workflow is cancelled or merge_group is destroyed
    steps:
      - name: Verify all checks succeeded
        run: |
          echo "Analyzing job results..."

          # Find any job whose result is 'failure' or 'cancelled' (ignoring 'success' and 'skipped')
          failures=\$(echo "\$NEEDS_RESULTS" | jq '[to_entries[] | select(.value.result == "failure" or .value.result == "cancelled")]')
          
          if [ "\$(echo "\$failures" | jq '. | length')" -ne 0 ]; then
            echo "ERROR: One or more checks failed or were cancelled:"
            echo "\$failures" | jq '.[] | {job: .key, result: .value.result}'
            exit 1
          fi
          echo "All checks completed successfully or were skipped safely!"
        env:
          NEEDS_RESULTS: \${{ toJSON(needs) }}
EOF


cat >> ${REPO_ROOT}/.github/workflows/ci-presubmit.yaml <<'EOF'

concurrency:
  group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
  cancel-in-progress: true
EOF

