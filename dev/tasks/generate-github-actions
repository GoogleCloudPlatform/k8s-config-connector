# Every job below (except presubmit-gatekeeper) lists plan-tests in its needs
# and gates its if on a plan-tests output. Generic jobs get their condition
# from job_condition. Keep that pattern for any new job.
#
# job_condition prints the plan-tests output that gates a generic job:
#   run_ci     - runs whenever anything runs (lint/validate, unknown new jobs)
#   run_global - only for changes that are not scoped to services
job_condition() {
    case "$1" in
        capture-pprof|smoketest-with-kind|test-pause|tests-gcptracker|tests-preview|unit-tests-operator)
            echo "needs.plan-tests.outputs.run_global == 'true'" ;;
        test-mockgcp)
            echo "needs.plan-tests.outputs.run_mock == 'true'" ;;
        test-fuzz-random-mappers)
            echo "needs.plan-tests.outputs.has_fuzz == 'true'" ;;
        *)
            echo "needs.plan-tests.outputs.run_ci == 'true'" ;;
    esac
}

# job_env prints extra step env lines for generic jobs that accept a scope.
