set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd ${REPO_ROOT}

if [[ -z "${KUBEBUILDER_ASSETS:-}" ]] || [[ ! -d "${KUBEBUILDER_ASSETS}" ]]; then
  echo "Downloading envtest assets..."
  export KUBEBUILDER_ASSETS=$(go run sigs.k8s.io/controller-runtime/tools/setup-envtest@release-0.22 use -p path)
fi

# Set up transparent wrappers that set PR_SET_PDEATHSIG via setpriv so test
# control-plane processes (kube-apiserver, etcd) automatically terminate when their parent
# test process terminates, avoiding orphaned processes on test interruptions/timeouts.
#
# Note: Linux PR_SET_PDEATHSIG is tied to the thread that spawned the child (Go issue #27505).
# In Go runtime, OS threads are kept alive unless LockOSThread is exited, which makes this
# reliable for test runners.
if [[ "$(uname -s)" == "Linux" ]] && command -v setpriv >/dev/null; then
  ENVTEST_WRAPPER_DIR="${REPO_ROOT}/.build/envtest-bin"
  mkdir -p "${ENVTEST_WRAPPER_DIR}"
  for b in etcd kube-apiserver; do
    printf '#!/bin/sh\nexec setpriv --pdeathsig KILL -- "%s/%s" "$@"\n' "${KUBEBUILDER_ASSETS}" "$b" > "${ENVTEST_WRAPPER_DIR}/$b"
    chmod +x "${ENVTEST_WRAPPER_DIR}/$b"
  done
  export TEST_ASSET_ETCD="${ENVTEST_WRAPPER_DIR}/etcd"
  export TEST_ASSET_KUBE_APISERVER="${ENVTEST_WRAPPER_DIR}/kube-apiserver"
  unset ENVTEST_WRAPPER_DIR b
fi
