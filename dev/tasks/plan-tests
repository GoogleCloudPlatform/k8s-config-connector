def changed_files(root, base, head, three_dot):
    if not base or not head:
        return None
    sep = "..." if three_dot else ".."
    try:
        out = subprocess.run(["git", "diff", "--name-only", "--no-renames", f"{base}{sep}{head}"],
                             cwd=root, check=True, capture_output=True, text=True).stdout
    except subprocess.CalledProcessError as e:
        print(f"git diff failed: {e.stderr.strip()}", file=sys.stderr)
        return None
    return [l for l in out.splitlines() if l]


def diff_lines(root, base, head, three_dot, path):
    """Added/removed lines of path between base and head, or None."""
    if not base or not head:
        return None
    sep = "..." if three_dot else ".."
    try:
        out = subprocess.run(["git", "diff", "--unified=0", "--no-renames", f"{base}{sep}{head}", "--", path],
                             cwd=root, check=True, capture_output=True, text=True).stdout
    except subprocess.CalledProcessError:
        return None
    return [l[1:] for l in out.splitlines()
            if l[:1] in "+-" and not l.startswith("+++") and not l.startswith("---")]


def pr_labels(repo_slug, pr_number):
    """Fetches current PR labels (so a re-run after labeling sees them)."""
    if not repo_slug or not pr_number:
        return []
    try:
        out = subprocess.run(["gh", "api", f"repos/{repo_slug}/issues/{pr_number}/labels", "--jq", ".[].name"],
                             check=True, capture_output=True, text=True, timeout=60).stdout
        return out.split("\n")
    except (subprocess.SubprocessError, OSError) as e:
        print(f"could not fetch PR labels ({e}); ignoring", file=sys.stderr)
        return []


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--event", default=os.environ.get("EVENT_NAME", "pull_request"))
    p.add_argument("--base", default=None, help="base commit (default from PR_BASE_SHA/MG_BASE_SHA)")
    p.add_argument("--head", default=None, help="head commit (default from PR_HEAD_SHA/MG_HEAD_SHA)")
    p.add_argument("--files", nargs="*", default=None, help="use these changed files instead of git diff")
    p.add_argument("--json", action="store_true", help="print the plan as JSON")
    args = p.parse_args(argv)

    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], check=True,
                          capture_output=True, text=True).stdout.strip()

    if args.event == "merge_group":
        base = args.base or os.environ.get("MG_BASE_SHA")
        head = args.head or os.environ.get("MG_HEAD_SHA")
        three_dot = False
    else:
        base = args.base or os.environ.get("PR_BASE_SHA")
        head = args.head or os.environ.get("PR_HEAD_SHA")
        three_dot = True

    repo = Repo(root, diff_lines=lambda path: diff_lines(root, base, head, three_dot, path))
    if args.files is not None:
        changed = args.files
    else:
        changed = changed_files(root, base, head, three_dot)

    labels = []
    if args.event == "pull_request":
        labels = pr_labels(os.environ.get("GITHUB_REPOSITORY"), os.environ.get("PR_NUMBER"))

    try:
        plan = make_plan(repo, changed, args.event, labels)
    except Exception as e:  # never block CI on a planner bug: run everything
        print(f"planner error: {e!r}", file=sys.stderr)
        plan = full_plan(repo, f"planner error: {e!r}")

    if changed is not None:
        print(f"Changed files ({len(changed)}):")
        for f in changed[:200]:
            print(f"  {f}")
    print(f"Plan: scope={plan['scope']} ({plan['reason']})")
    if args.json:
        print(json.dumps(plan, indent=2))
    outputs = plan_outputs(plan)
    for k, v in outputs.items():
        print(f"{k}={v}")
    gh_out = os.environ.get("GITHUB_OUTPUT")
    if gh_out:
        with open(gh_out, "a") as fh:
            for k, v in outputs.items():
                fh.write(f"{k}={v}\n")
    gh_summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if gh_summary:
        with open(gh_summary, "a") as fh:
            fh.write(f"### Test plan: `{plan['scope']}`\n\n{plan['reason']}\n\n```json\n{json.dumps(plan, indent=2)}\n```\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
