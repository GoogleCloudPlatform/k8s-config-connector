set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

mkdir -p bin/ THIRD_PARTY_NOTICES/ MIRRORED_LIBRARY_SOURCE/

if [[ "${SKIP_IF_PRESENT:-0}" == "1" && -f bin/manager && -f bin/webhook && -f bin/operator && -f bin/deletiondefender && -f bin/recorder && -f bin/unmanageddetector ]]; then
  echo "===> [$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Binaries already compiled in bin/, skipping compile."
  if [[ ! -d operator/channels/packages/configconnector ]]; then
    echo "===> [$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Generating operator channels..."
    dev/tasks/generate-channels
  fi
  exit 0
fi

export CGO_ENABLED=0
export GOOS=linux
export GOARCH=amd64

LDFLAGS="-s -w -buildid="

BUILD_CLI="${BUILD_CLI:-1}"
SKIP_LICENSES="${SKIP_LICENSES:-0}"

targets=(
  ./cmd/deletiondefender
  ./cmd/webhook
  ./cmd/recorder
  ./cmd/unmanageddetector
  ./cmd/manager
)

if [[ "${BUILD_CLI}" != "0" ]]; then
  targets+=(./cmd/config-connector)
else
  touch bin/config-connector
fi

# Unified single go build invocation to share the apis/ and pkg/ compilation graph.
# NOTE: '-p 4' was determined via rigorous 5-iteration zero-cache A/B testing (P=2..10) on 4-vCPU GitHub Actions runners.
# Do not modify '-p 4' unless a new zero-cache A/B test explicitly demonstrates performance improvements.
go build -trimpath -buildvcs=false -p 4 -ldflags "${LDFLAGS}" -o bin/ "${targets[@]}"
go build -trimpath -buildvcs=false -p 4 -ldflags "${LDFLAGS}" -o bin/operator ./operator/cmd/manager
go build -trimpath -buildvcs=false -p 4 -ldflags "${LDFLAGS}" -o bin/gke_addon_poststart ./operator/cmd/gke_addon_poststart

if [[ "${SKIP_LICENSES}" == "0" ]]; then
  echo "===> [$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Generating third-party notices..."
  GOWORK=off go mod vendor -o temp-vendor
  go run scripts/generate-third-party-licenses/main.go
  rm -rf temp-vendor
else
  echo "===> [$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Skipping third-party notices (SKIP_LICENSES=1)"
  mkdir -p THIRD_PARTY_NOTICES MIRRORED_LIBRARY_SOURCE
  touch THIRD_PARTY_NOTICES/.placeholder MIRRORED_LIBRARY_SOURCE/.placeholder
fi

echo "===> [$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Generating operator channels..."
dev/tasks/generate-channels

echo "===> [$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Trimming historical channel versions for artifact upload..."
LATEST_VERSION=$(cat version/VERSION)
for dir in operator/channels/packages/configconnector/*/ operator/autopilot-channels/packages/configconnector/*/; do
  ver=$(basename "${dir}")
  if [[ "${ver}" != "${LATEST_VERSION}" && -d "${dir}" ]]; then
    rm -rf "${dir}"
  fi
done

echo "===> [$(date -u +'%Y-%m-%dT%H:%M:%SZ')] Native host compilation complete."
