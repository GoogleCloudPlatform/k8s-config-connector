# dev/ci/periodics/e2e-suite is the master runner script for periodic E2E tests.
#
# Periodic jobs run on a recurring schedule (nightly/hourly) against REAL GCP (E2E_GCP_TARGET=real).
# They provision a real GCP project, run fixture tests (TestAllInSeries/fixtures), and produce
# a golden.zip artifact containing real HTTP traffic logs (_http.log) used to update mockgcp.
#
# Usage:
#   dev/ci/periodics/e2e-suite <service_short_name>
#
# Default Behavior:
#   - ONLY_TEST_APIGROUPS is set to <service>.cnrm.cloud.google.com
#   - EXTRA_GCP_SERVICES defaults to <service>.googleapis.com for ~90% of standard services.

set -o errexit
set -o nounset
set -o pipefail

SERVICE="${1:-${SERVICE_NAME:-}}"
if [[ -z "${SERVICE}" ]]; then
  echo "Usage: $0 <service_short_name>"
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

export ONLY_TEST_APIGROUPS="${SERVICE}.cnrm.cloud.google.com"

extra_services="${SERVICE}.googleapis.com"
# Override EXTRA_GCP_SERVICES for services where the GCP API endpoint name differs
# from the KCC short name (e.g. sql -> sqladmin.googleapis.com, kms -> cloudkms.googleapis.com)
# or where multiple GCP APIs must be enabled in the test project upfront.
case "${SERVICE}" in
  "analytics") extra_services="analyticsadmin.googleapis.com" ;;
  "bigqueryanalyticshub") extra_services="analyticshub.googleapis.com" ;;
  "bigquerybiglake") extra_services="biglake.googleapis.com" ;;
  "certificatemanager") extra_services="certificatemanager.googleapis.com servicedirectory.googleapis.com privateca.googleapis.com" ;;
  "clouddms") extra_services="datamigration.googleapis.com" ;;
  "cloudfunctions2") extra_services="cloudfunctions.googleapis.com" ;;
  "cloudids") extra_services="ids.googleapis.com" ;;
  "containerattached") extra_services="gkemulticloud.googleapis.com" ;;
  "dialogflowcx") extra_services="dialogflow.googleapis.com" ;;
  "filestore") extra_services="file.googleapis.com" ;;
  "kms") extra_services="cloudkms.googleapis.com" ;;
  "mlengine") extra_services="ml.googleapis.com" ;;
  "resourcemanager") extra_services="cloudresourcemanager.googleapis.com" ;;
  "sql") extra_services="sqladmin.googleapis.com" ;;
  "tags") extra_services="cloudresourcemanager.googleapis.com" ;;
esac

export EXTRA_GCP_SERVICES="${extra_services}"

dev/ci/periodics/_create_project_and_run_e2e
