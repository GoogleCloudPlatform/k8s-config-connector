set -o errexit
set -o nounset
set -o pipefail

function on_error() {
  echo "<hint_for_agent>Run 'dev/ci/presubmits/tests-e2e-samples-suite' to fix.</hint_for_agent>"
}
trap on_error ERR

SERVICE="${1:-${SERVICE_NAME:-}}"
if [[ -z "${SERVICE}" ]]; then
  echo "Usage: $0 <service_short_name>"
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

. "${REPO_ROOT}/dev/tasks/setup-envtest"

if [[ "${SERVICE}" == "unclassified" ]]; then
  unset ONLY_TEST_APIGROUPS
else
  export ONLY_TEST_APIGROUPS="${SERVICE}.cnrm.cloud.google.com"
fi

export USE_FULL_TEST_NAMES=true
export TEST_TIMEOUT=15m

if [[ -z "${PREBUILT_TEST_BINARY:-}" ]]; then
  if [[ -f "${REPO_ROOT}/bin/tests-e2e" ]]; then
    export PREBUILT_TEST_BINARY="${REPO_ROOT}/bin/tests-e2e"
  else
    export PREBUILT_TEST_BINARY="${REPO_ROOT}/.build/tests-e2e"
    mkdir -p "${REPO_ROOT}/.build"
    if [[ ! -f "${PREBUILT_TEST_BINARY}" ]]; then
      echo "Prebuilding e2e tests..."
      time go test -c -o "${PREBUILT_TEST_BINARY}" ./tests/e2e
    fi
  fi
fi

echo "Running ${SERVICE} samples tests..."
${PREBUILT_TEST_BINARY} -test.run "^TestAllInSeries/samples$" -test.timeout 15m -test.v
