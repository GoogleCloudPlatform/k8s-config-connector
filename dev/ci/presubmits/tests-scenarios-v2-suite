set -o errexit
set -o nounset
set -o pipefail

function on_error() {
  echo "<hint_for_agent>Run 'dev/ci/presubmits/tests-scenarios-v2-suite' to fix.</hint_for_agent>"
}
trap on_error ERR

SUITE="${1:-${SUITE_NAME:-}}"
if [[ -z "${SUITE}" ]]; then
  echo "Usage: $0 <suite_name>"
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

. "${REPO_ROOT}/dev/tasks/setup-envtest"

export RUN_E2E=1
export E2E_GCP_TARGET="${E2E_GCP_TARGET:-mock}"
export E2E_KUBE_TARGET="${E2E_KUBE_TARGET:-envtest}"
export USE_FULL_TEST_NAMES=true
export TEST_TIMEOUT=15m

if [[ -z "${PREBUILT_TEST_BINARY:-}" ]]; then
  if [[ -f "${REPO_ROOT}/bin/tests-e2e" ]]; then
    export PREBUILT_TEST_BINARY="${REPO_ROOT}/bin/tests-e2e"
  else
    export PREBUILT_TEST_BINARY="${REPO_ROOT}/.build/tests-e2e"
    mkdir -p "${REPO_ROOT}/.build"
    if [[ ! -f "${PREBUILT_TEST_BINARY}" ]]; then
      echo "Prebuilding e2e tests..."
      time go test -c -o "${PREBUILT_TEST_BINARY}" ./tests/e2e
    fi
  fi
fi

echo "Running ${SUITE} V2 scenarios tests..."
cd tests/e2e
${PREBUILT_TEST_BINARY} -test.run "^TestE2EScenariosV2/scenarios/${SUITE}$" -test.timeout 15m -test.v
