set -o errexit
set -o nounset
set -o pipefail

function on_error() {
  echo "<hint_for_agent>Run 'dev/ci/presubmits/tests-e2e-fixtures-suite' to fix.</hint_for_agent>"
}
trap on_error ERR

SERVICE="${1:-${SERVICE_NAME:-}}"
if [[ -z "${SERVICE}" ]]; then
  echo "Usage: $0 <service_short_name>"
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

. "${REPO_ROOT}/dev/tasks/setup-envtest"

BASE_TEST="TestAllInSeries/fixtures"
# Special cross-cutting fixture categories (reconcileintervalannotations, stateabsentinspec)
# contain resources spanning multiple API groups. Instead of restricting by ONLY_TEST_APIGROUPS,
# we override BASE_TEST to point directly to their testdata directory. Standard CRD services
# (storage, compute, etc.) filter by ONLY_TEST_APIGROUPS.
if [[ "${SERVICE}" == "reconcileintervalannotations" || "${SERVICE}" == "stateabsentinspec" ]]; then
  BASE_TEST="TestAllInSeries/fixtures/pkg/test/resourcefixture/testdata/${SERVICE}"
else
  export ONLY_TEST_APIGROUPS="${SERVICE}.cnrm.cloud.google.com"
fi
export USE_FULL_TEST_NAMES=true
export TEST_TIMEOUT=15m

if [[ -z "${PREBUILT_TEST_BINARY:-}" ]]; then
  if [[ -f "${REPO_ROOT}/bin/tests-e2e" ]]; then
    export PREBUILT_TEST_BINARY="${REPO_ROOT}/bin/tests-e2e"
  else
    export PREBUILT_TEST_BINARY="${REPO_ROOT}/.build/tests-e2e"
    mkdir -p "${REPO_ROOT}/.build"
    if [[ ! -f "${PREBUILT_TEST_BINARY}" ]]; then
      echo "Prebuilding e2e tests..."
      time go test -c -o "${PREBUILT_TEST_BINARY}" ./tests/e2e
    fi
  fi
fi

PARALLEL_TEST_RUNNER="${REPO_ROOT}/.build/paralleltestrunner"
if [[ -f "${REPO_ROOT}/bin/paralleltestrunner" ]]; then
  PARALLEL_TEST_RUNNER="${REPO_ROOT}/bin/paralleltestrunner"
elif [[ ! -f "${PARALLEL_TEST_RUNNER}" ]]; then
  echo "Building paralleltestrunner..."
  time go build -o "${PARALLEL_TEST_RUNNER}" "${REPO_ROOT}/dev/tools/paralleltestrunner"
fi

SHARD_INDEX="${2:-0}"
TOTAL_SHARDS="${3:-1}"

SHARD_FLAGS=""
if [[ "${TOTAL_SHARDS}" -gt 1 ]]; then
  SHARD_FLAGS="-shard-index=${SHARD_INDEX} -total-shards=${TOTAL_SHARDS}"
fi

echo "Running ${SERVICE} fixtures tests in parallel..."
${PARALLEL_TEST_RUNNER} \
    -list-file="${REPO_ROOT}/tests/e2e/testdata/fixtures-${SERVICE}-list.txt" \
    -base-test="${BASE_TEST}" \
    -check-unchanged=true \
    ${SHARD_FLAGS} \
    -- ${REPO_ROOT}/dev/tasks/run-e2e
